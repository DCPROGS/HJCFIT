# Auto detect text files and perform LF normalization
* text=auto

# Custom for Visual Studio
*.cs     diff=csharp
*.sln    merge=union
*.csproj merge=union
*.vbproj merge=union
*.fsproj merge=union
*.dbproj merge=union

# Standard to msysgit
*.doc  diff=astextplain
*.DOC  diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF  diff=astextplain
*.rtf  diff=astextplain
*.RTF  diff=astextplain

# The vendored Fortran in tests/dcfortran/vendor is copied byte for byte out of
# DCPROGS/DCFORTRAN, and its SHA-256s are recorded in MANIFEST.txt and checked
# by tests/test_fortran_likelihood.py. Line-ending normalisation would rewrite
# the DOS CRLFs on checkout and every hash would fail, so these files are
# stored and checked out exactly as they are. "Unmodified" has to mean bytes.
tests/dcfortran/vendor/** -text

# replacements/eispack is verbatim netlib EISPACK and its SHA-256s are recorded
# in replacements/PROVENANCE.md, for the same reason and with the same
# consequence as vendor/ above.
tests/dcfortran/replacements/eispack/** -text
